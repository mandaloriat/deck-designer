{
  "name": "deck-designer",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean && rm -rf packages/*/dist",
    "typecheck": "tsc --build --dry 2>/dev/null || tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "deck": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "1.56.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
